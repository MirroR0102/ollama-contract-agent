# ================== Ollama 本地服务配置（全程离线，无任何云 API） ==================
# Ollama 默认服务地址与端口，模型推理/向量化都走这里
OLLAMA_HOST=http://localhost:11434

# 大语言模型（问答 / 合同审查 / 要素抽取 / Agent 推理）
# 推荐 ollama pull qwen2.5:7b（支持原生工具调用，稳定）；备选 qwen2.5-coder:7b（不支持工具调用）
LLM_MODEL=qwen2.5:7b

# 向量嵌入模型（合同文档向量化检索）
#   执行 ollama pull bge-m3      下载（多语言效果好，中文合同推荐）
#   备选：bge-small / nomic-embed-text
#   说明：嵌入固定使用本地模型（切换嵌入=向量空间变化须全量重建，详见 README）
EMBED_MODEL=bge-m3

# ================== 云端大模型（可选 · 联网模式） ==================
# 支持任意 OpenAI 兼容接口：DeepSeek（默认）/ 通义 / Kimi / 硅基流动 / OpenAI 等。
# 以 DeepSeek 为例：到 https://platform.deepseek.com 创建 API Key 填入下方即可。
# 网页端右上角「模型设置」可按用户切换 本地 ⇄ 云端；
# CLOUD_API_KEY 留空时，用户仍可在网页端填写自己的「个人 Key」（按用户隔离保存）。
# ⚠️ 联网模式下，检索到的合同片段会发送至云端服务商，敏感数据请使用本地模式。
CLOUD_BASE_URL=https://api.deepseek.com/v1
CLOUD_API_KEY=
CLOUD_MODEL=deepseek-chat

# 默认模型引擎：local（本地离线）/ cloud（云端联网）；网页端登录后可自行切换
LLM_PROVIDER=local

# ================== 业务配置 ==================
# Chroma 向量数据库本地存储目录
CHROMA_PATH=./chroma_db

# 合同文档目录（入库 / 审查时的合同都放这里）
CONTRACTS_DIR=./contracts

# 文档分块参数（按课程标准，可自行调优）
CHUNK_SIZE=450
CHUNK_OVERLAP=80

# ================== 数据库（用户系统与合同库归属） ==================
# 存储合同归属与用户账号。mysql 需要本机 MySQL（>=8.0，自带 caching_sha2_password 认证）；
# 也可用 sqlite（本地文件免配置），二者代码完全相同、随时可切。
DB_ENGINE=mysql            # mysql / sqlite
DB_PATH=./contract_ai.db   # sqlite 用（本地文件）
DB_HOST=127.0.0.1          # mysql 用
DB_PORT=3306
DB_USER=root
# ↓ 填写你本机 MySQL 密码（.env 已被 gitignore，不会提交）
DB_PASSWORD=
DB_NAME=contract_ai

# 预置演示账号（存放 contracts 演示合同；登录页会显示提示）
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
