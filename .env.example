# ================== Ollama 本地服务配置（全程离线，无任何云 API） ==================
# Ollama 默认服务地址与端口，模型推理/向量化都走这里
OLLAMA_HOST=http://localhost:11434

# 大语言模型（问答 / 合同审查 / 要素抽取 / Agent 推理）
# 推荐 ollama pull qwen2.5:7b（支持原生工具调用，稳定）；备选 qwen2.5-coder:7b（不支持工具调用）
LLM_MODEL=qwen2.5:7b

# 向量嵌入模型（合同文档向量化检索）
#   执行 ollama pull bge-m3      下载（多语言效果好，中文合同推荐）
#   备选：bge-small / nomic-embed-text
EMBED_MODEL=bge-m3

# ================== 业务配置 ==================
# Chroma 向量数据库本地存储目录
CHROMA_PATH=./chroma_db

# 合同文档目录（入库 / 审查时的合同都放这里）
CONTRACTS_DIR=./contracts

# 文档分块参数（按课程标准，可自行调优）
CHUNK_SIZE=450
CHUNK_OVERLAP=80

# ================== 数据库（用户系统与合同库归属） ==================
# 存储合同归属与用户账号。mysql 需要本机 MySQL（>=8.0，自带 caching_sha2_password 认证）；
# 也可用 sqlite（本地文件免配置），二者代码完全相同、随时可切。
DB_ENGINE=mysql            # mysql / sqlite
DB_PATH=./contract_ai.db   # sqlite 用（本地文件）
DB_HOST=127.0.0.1          # mysql 用
DB_PORT=3306
DB_USER=root
# ↓ 填写你本机 MySQL 密码（.env 已被 gitignore，不会提交）
DB_PASSWORD=
DB_NAME=contract_ai

# 预置演示账号（存放 contracts 演示合同；登录页会显示提示）
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
